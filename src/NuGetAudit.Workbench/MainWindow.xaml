<Window x:Class="NuGetAudit.Workbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NuGetAudit.Workbench"
        xmlns:surface="clr-namespace:NuGetAudit.Presentation;assembly=NuGetAudit.Presentation"
        mc:Ignorable="d"
        Title="NuGet Audit Workbench"
        Width="1600"
        Height="980"
        MinWidth="1200"
        MinHeight="780"
        Loaded="Window_Loaded"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Window.Resources>
        <!-- Border carries fill so audit status chips stay visible under modern DataGrid / Fluent cell chrome. -->
        <Style x:Key="CatalogStatusBadgeBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AuditStatus}" Value="complete">
                    <Setter Property="Background" Value="#DCFCE7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuditStatus}" Value="auditing">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuditStatus}" Value="queued">
                    <Setter Property="Background" Value="#FEF3C7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuditStatus}" Value="failed">
                    <Setter Property="Background" Value="#FEE2E2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuditStatus}" Value="discovered">
                    <Setter Property="Background" Value="#EDE9FE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuditStatus}" Value="mixed">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CatalogStatusBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AuditStatus}" Value="complete">
                    <Setter Property="Foreground" Value="#166534"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuditStatus}" Value="auditing">
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuditStatus}" Value="queued">
                    <Setter Property="Foreground" Value="#92400E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuditStatus}" Value="failed">
                    <Setter Property="Foreground" Value="#B91C1C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuditStatus}" Value="discovered">
                    <Setter Property="Foreground" Value="#6D28D9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuditStatus}" Value="mixed">
                    <Setter Property="Foreground" Value="#475569"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TransparentDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0E7EF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GridCellTextStyle" TargetType="TextBlock">
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </Window.Resources>
    <Grid Background="#F8FAFC">
        <TabControl x:Name="MainTabControl" Margin="12" SelectionChanged="MainTabControl_SelectionChanged">
            <TabItem Header="Discover">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Path" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBox x:Name="DiscoverPathTextBox" Grid.Column="1" Margin="0,0,12,0" Padding="8,6" VerticalContentAlignment="Center"
                                 ToolTip="Enter a folder path to scan, or leave empty and click Add to choose a folder."/>
                        <Button x:Name="DiscoverAddButton" Grid.Column="2" Padding="16,6" MinWidth="90" Click="DiscoverAddButton_Click" Content="Add"/>
                    </Grid>
                    <Border Grid.Row="1" Background="White" BorderBrush="#D7DEE7" BorderThickness="1" CornerRadius="10" Padding="4">
                        <ListBox x:Name="DiscoverPathsListBox"
                                 DisplayMemberPath="FolderPath"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Border>
                    <Border Grid.Row="2" Margin="0,16,0,0" Padding="12" CornerRadius="12" Background="White" BorderBrush="#D7DEE7" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Run a single audit on one solution or project file."
                                       Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Input" FontWeight="SemiBold" Margin="0,0,12,6"/>
                            <TextBox x:Name="InputPathTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,12,6" Padding="8,6" VerticalContentAlignment="Center"
                                     ToolTip="Drop or browse to a .sln, .slnx, .csproj, .vbproj, or .fsproj file."/>
                            <Button Grid.Row="1" Grid.Column="2" Margin="0,0,0,6" Padding="14,6" Click="BrowseButton_Click" Content="Browse..."/>
                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Output" FontWeight="SemiBold" Margin="0,0,12,0"/>
                            <TextBox x:Name="OutputDirectoryTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6" Padding="8,6" VerticalContentAlignment="Center"/>
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                                <Button x:Name="RunButton" Padding="16,6" Click="RunButton_Click" Content="Run Audit"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock x:Name="SummaryTextBlock" Text="Choose an input file, then run the audit." FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ComparisonTextBlock" Margin="0,2,0,0" Foreground="#475569" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ReportPathsTextBlock" Margin="0,2,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
                        <Border x:Name="ErrorDetailsBorder" Margin="0,8,0,0" Padding="8" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
                            <TextBox x:Name="ErrorDetailsTextBox" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" AcceptsTab="True"
                                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     MinHeight="80" MaxHeight="200" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Process">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="ProcessStartButton" Padding="16,8" MinWidth="100" Click="ProcessStartButton_Click" Content="Start"/>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,0,0,8" Padding="10,6" CornerRadius="10" Background="White" BorderBrush="#D7DEE7" BorderThickness="1">
                        <WrapPanel>
                            <TextBlock Text="Status key:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" Foreground="#334155"/>
                            <Border Background="#DCFCE7" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="complete" FontWeight="SemiBold" Foreground="#166534"/>
                            </Border>
                            <Border Background="#DBEAFE" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="auditing" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                            </Border>
                            <Border Background="#FEF3C7" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="queued" FontWeight="SemiBold" Foreground="#92400E"/>
                            </Border>
                            <Border Background="#FEE2E2" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="failed" FontWeight="SemiBold" Foreground="#B91C1C"/>
                            </Border>
                            <Border Background="#EDE9FE" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="discovered" FontWeight="SemiBold" Foreground="#6D28D9"/>
                            </Border>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="mixed" FontWeight="SemiBold" Foreground="#475569"/>
                            </Border>
                        </WrapPanel>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="430"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Padding="8" Background="White" BorderBrush="#D7DEE7" BorderThickness="1" CornerRadius="10">
                        <TreeView x:Name="CatalogTreeView"
                                  SelectedItemChanged="CatalogTreeView_SelectedItemChanged"
                                  ContextMenuOpening="CatalogTreeView_ContextMenuOpening"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="CatalogTreeAuditMenuItem" Header="Audit Selected Scope" Click="CatalogTreeAuditMenuItem_Click"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.Resources>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                </Style>
                                <HierarchicalDataTemplate DataType="{x:Type local:CatalogTreeNode}" ItemsSource="{Binding Children}">
                                    <StackPanel Margin="0,2,0,2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </Border>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.3*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="3.7*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="10" MinHeight="122" Background="White" BorderBrush="#D7DEE7" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock Text="Selected Scope" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <Button x:Name="ScopeAuditButton" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="12,4" Click="ScopeAuditButton_Click" Content="Audit Scope"/>
                                        <Button x:Name="ScopeRetryFailedButton" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="12,4" Click="RetryScopeFailedButton_Click" Content="Retry Failed"/>
                                    </DockPanel>
                                    <TextBox x:Name="CatalogScopeDetailsTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" MinHeight="82" MaxHeight="120" VerticalScrollBarVisibility="Auto"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Padding="10" Background="White" BorderBrush="#D7DEE7" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" LastChildFill="False">
                                        <TextBlock Text="Audit Queue" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <Button x:Name="RetrySelectedQueueItemButton" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="12,4" Click="RetrySelectedQueueItemButton_Click" Content="Retry Selected Failed"/>
                                        <Button x:Name="RetryScopeFailedButton" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="12,4" Click="RetryScopeFailedButton_Click" Content="Retry Failed In Scope"/>
                                    </DockPanel>
                                    <TextBlock x:Name="QueueSummaryTextBlock" Grid.Row="1" Margin="0,4,0,6" Foreground="#475569" TextWrapping="Wrap"
                                               Text="No queued or failed audit items are visible in the current scope."/>
                                    <DataGrid x:Name="QueueGrid"
                                              Grid.Row="2"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              SelectionMode="Single"
                                              SelectionChanged="QueueGrid_SelectionChanged"
                                              MouseDoubleClick="QueueGrid_MouseDoubleClick"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Height="110"
                                              CellStyle="{StaticResource TransparentDataGridCellStyle}"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Standard"
                                              ScrollViewer.CanContentScroll="True">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Status" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource CatalogStatusBadgeBorderStyle}">
                                                            <TextBlock Text="{Binding AuditStatus}" Style="{StaticResource CatalogStatusBadgeTextStyle}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="170" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                            <DataGridTextColumn Header="Folder" Binding="{Binding FolderPath}" Width="190" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                            <DataGridTextColumn Header="Input Path" Binding="{Binding InputPath}" Width="*" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                            <DataGridTextColumn Header="Failure" Binding="{Binding FailureReason}" Width="220" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                        <TabControl x:Name="CatalogDataTabControl" Grid.Row="1" SelectedIndex="0">
                            <TabItem Header="Folders">
                                <DataGrid x:Name="FolderCatalogGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CellStyle="{StaticResource TransparentDataGridCellStyle}"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Standard"
                                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Folder Path" Binding="{Binding FolderPath}" Width="*" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTemplateColumn Header="Audit Status" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource CatalogStatusBadgeBorderStyle}">
                                                        <TextBlock Text="{Binding AuditStatus}" Style="{StaticResource CatalogStatusBadgeTextStyle}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Solutions" Binding="{Binding SolutionCount}" Width="100" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Projects" Binding="{Binding ProjectCount}" Width="100" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Packages" Binding="{Binding PackageCount}" Width="100" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Targets" Binding="{Binding TrackedTargetCount}" Width="100" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Last Scan Status" Binding="{Binding LastScanStatus}" Width="220" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Last Scanned UTC" Binding="{Binding LastScannedUtc}" Width="180" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Solutions">
                                <DataGrid x:Name="CatalogGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CellStyle="{StaticResource TransparentDataGridCellStyle}"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Standard"
                                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Audit Status" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource CatalogStatusBadgeBorderStyle}">
                                                        <TextBlock Text="{Binding AuditStatus}" Style="{StaticResource CatalogStatusBadgeTextStyle}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Solution" Binding="{Binding SolutionName}" Width="180" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Solution Path" Binding="{Binding SolutionPath}" Width="*" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Projects" Binding="{Binding ProjectCount}" Width="100" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Packages" Binding="{Binding PackageCount}" Width="100" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Analysis" Binding="{Binding AnalysisStatus}" Width="110" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Captured UTC" Binding="{Binding CapturedUtc}" Width="180" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Packages">
                                <DataGrid x:Name="PackageCatalogGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CellStyle="{StaticResource TransparentDataGridCellStyle}"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Standard"
                                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Audit Status" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource CatalogStatusBadgeBorderStyle}">
                                                        <TextBlock Text="{Binding AuditStatus}" Style="{StaticResource CatalogStatusBadgeTextStyle}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Solution" Binding="{Binding SolutionName}" Width="180" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="180" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Package" Binding="{Binding PackageId}" Width="170" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Requested" Binding="{Binding RequestedVersion}" Width="110" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Resolved" Binding="{Binding ResolvedVersion}" Width="110" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Kind" Binding="{Binding ReferenceKind}" Width="90" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header=".NET version" Binding="{Binding TargetFramework}" Width="120" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Health" Binding="{Binding HealthState}" Width="130" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                        <DataGridTextColumn Header="Project Path" Binding="{Binding ProjectPath}" Width="*" ElementStyle="{StaticResource GridCellTextStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="12" Background="White" BorderBrush="#D7DEE7" BorderThickness="1" CornerRadius="10">
                            <TextBlock x:Name="GeneratedFilesTextBlock" Text="Generated report paths will appear here." TextWrapping="Wrap"/>
                        </Border>
                        <Border Grid.Row="1" Margin="0,8,0,0" Padding="8" Background="White" BorderBrush="#D7DEE7" BorderThickness="1" CornerRadius="10">
                            <TextBox x:Name="MarkdownPreviewTextBox" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" AcceptsTab="True"
                                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Visualise">
                <surface:PresentationControl x:Name="ExplorerSurface" Margin="0,12,0,0"/>
            </TabItem>

            <TabItem Header="History">
                <surface:HistoryTimelineControl x:Name="HistorySurface" Margin="0,12,0,0"/>
            </TabItem>

            <TabItem Header="Issues">
                <surface:IssueRollupControl x:Name="IssueSurface" Margin="0,12,0,0"/>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
